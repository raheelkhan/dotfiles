{
  "permissions": {
    "deny": [
      "Read(//Users/raheel/.zshrc.local)",
      "Read(**/.zshrc.local)",
      "Bash(cat *.zshrc.local*)",
      "Bash(cat *~/.zshrc.local*)",
      "Bash(less *.zshrc.local*)",
      "Bash(head *.zshrc.local*)",
      "Bash(tail *.zshrc.local*)",
      "Bash(env)",
      "Bash(printenv*)"
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "zarpay-nexus": {
      "source": {
        "source": "github",
        "repo": "zarpay/nexus"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "terminalConfig": {
    "vimMode": false
  }
}
